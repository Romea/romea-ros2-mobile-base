<?xml version='1.0' encoding='utf-8'?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="prefix" value="robot_" />
  <xacro:property name="front_left_wheel_swiveling_joint" value="joint1" />
  <xacro:property name="front_right_wheel_swiveling_joint" value="joint2" />
  <xacro:property name="front_left_wheel_spinning_joint" value="joint3" />
  <xacro:property name="front_right_wheel_spinning_joint" value="joint4" />
  <xacro:property name="rear_left_wheel_spinning_joint" value="joint5" />
  <xacro:property name="rear_right_wheel_spinning_joint" value="joint6" />

  <xacro:property name="live_hardware_plugin" value="foo" />
  <xacro:property name="wheelbase" value="1.2" />
  <xacro:property name="front_track" value="1.4" />
  <xacro:property name="front_wheel_x_offset" value="0.1" />
  <xacro:property name="front_wheel_radius" value="0.5" />
  <xacro:property name="rear_track" value="1.0" />
  <xacro:property name="rear_wheel_radius" value="0.3" />
  <xacro:property name="maximal_wheel_speed" value="1.0" />

  <xacro:property name="base_link" value="base_link" />
  <xacro:property name="front_left_wheel_swiveling_link" value="front_left_wheel_swiveling_link" />
  <xacro:property name="front_right_wheel_swiveling_link" value="front_right_wheel_swiveling_link" />
  <xacro:property name="front_left_wheel_spinning_link" value="front_left_wheel_spinning_link" />
  <xacro:property name="front_right_wheel_spinning_link" value="front_right_wheel_spinning_link" />
  <xacro:property name="rear_left_wheel_spinning_link" value="rear_left_wheel_spinning_link" />
  <xacro:property name="rear_right_wheel_spinning_link" value="rear_right_wheel_spinning_link" />
  <xacro:property name="maximal_wheel_torque" value="10000000" />

  <xacro:include
    filename="$(find romea_mobile_base_description)/ros2_control/base2FWC2RWD.ros2_control.xacro" />
  <xacro:base_control mode="live" base_name="base" hardware_plugin="${live_hardware_plugin}" />

</robot>
