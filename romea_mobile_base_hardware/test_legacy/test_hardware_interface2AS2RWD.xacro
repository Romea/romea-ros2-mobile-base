<?xml version='1.0' encoding='utf-8'?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="prefix" value="robot_" />
  <xacro:property name="front_axle_steering_joint" value="joint1" />
  <xacro:property name="rear_axle_steering_joint" value="joint2" />
  <xacro:property name="rear_left_wheel_spinning_joint" value="joint3" />
  <xacro:property name="rear_right_wheel_spinning_joint" value="joint4" />
  <xacro:property name="front_left_wheel_steering_joint" value="joint5" />
  <xacro:property name="front_right_wheel_steering_joint" value="joint6" />
  <xacro:property name="rear_left_wheel_steering_joint" value="joint7" />
  <xacro:property name="rear_right_wheel_steering_joint" value="joint8" />
  <xacro:property name="front_left_wheel_spinning_joint" value="joint9" />
  <xacro:property name="front_right_wheel_spinning_joint" value="joint10" />
  <xacro:property name="rear_wheel_radius" value="0.2" />
  <xacro:property name="maximal_axle_steering_angle" value="0.5" />
  <xacro:property name="maximal_wheel_speed" value="1.0" />

  <xacro:property name="live_hardware_plugin" value="foo" />
  <xacro:property name="wheelbase" value="1.3" />
  <xacro:property name="front_track" value="1.2" />
  <xacro:property name="front_wheel_radius" value="0.4" />
  <xacro:property name="front_hub_carrier_offset" value="0.1" />
  <xacro:property name="rear_track" value="1.2" />
  <xacro:property name="rear_wheel_radius" value="0.6" />
  <xacro:property name="rear_hub_carrier_offset" value="0.1" />
  <xacro:property name="maximal_axle_steering_angle" value="0.5" />
  <xacro:property name="maximal_wheel_steering_angle" value="1.0" />
  <xacro:property name="maximal_wheel_speed" value="1.0" />

  <link name="${prefix}base_link" />
  <link name="${prefix}front_axle_steering_link" />
  <link name="${prefix}rear_axle_steering_link" />
  <link name="${prefix}rear_left_wheel_spinning_link" />
  <link name="${prefix}rear_right_wheel_spinning_link" />
  <link name="${prefix}front_left_wheel_steering_link" />
  <link name="${prefix}front_right_wheel_steering_link" />
  <link name="${prefix}rear_left_wheel_steering_link" />
  <link name="${prefix}rear_right_wheel_steering_link" />
  <link name="${prefix}front_left_wheel_spinning_link" />
  <link name="${prefix}front_right_wheel_spinning_link" />

  <joint name="${prefix}${front_axle_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}front_axle_steering_link" />
    <limit lower="${-maximal_axle_steering_angle}" upper="${maximal_axle_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${rear_axle_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}rear_axle_steering_link" />
    <limit lower="${-maximal_axle_steering_angle}" upper="${maximal_axle_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${rear_left_wheel_spinning_joint}" type="continuous">
    <parent link="${prefix}base_link" />
    <child link="${prefix}rear_left_wheel_spinning_link" />
  </joint>
  <joint name="${prefix}${rear_right_wheel_spinning_joint}" type="continuous">
    <parent link="${prefix}base_link" />
    <child link="${prefix}rear_right_wheel_spinning_link" />
  </joint>
  <joint name="${prefix}${front_left_wheel_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}front_left_wheel_steering_link" />
    <limit lower="${-maximal_wheel_steering_angle}" upper="${maximal_wheel_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${front_right_wheel_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}front_right_wheel_steering_link" />
    <limit lower="${-maximal_wheel_steering_angle}" upper="${maximal_wheel_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${rear_left_wheel_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}rear_left_wheel_steering_link" />
    <limit lower="${-maximal_wheel_steering_angle}" upper="${maximal_wheel_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${rear_right_wheel_steering_joint}" type="revolute">
    <parent link="${prefix}base_link" />
    <child link="${prefix}rear_right_wheel_steering_link" />
    <limit lower="${-maximal_wheel_steering_angle}" upper="${maximal_wheel_steering_angle}"
      effort="10000000" velocity="1000000" />
  </joint>
  <joint name="${prefix}${front_left_wheel_spinning_joint}" type="continuous">
    <parent link="${prefix}front_left_wheel_steering_link" />
    <child link="${prefix}front_left_wheel_spinning_link" />
  </joint>
  <joint name="${prefix}${front_right_wheel_spinning_joint}" type="continuous">
    <parent link="${prefix}front_right_wheel_steering_link" />
    <child link="${prefix}front_right_wheel_spinning_link" />
  </joint>

  <xacro:include
    filename="$(find romea_mobile_base_description)/ros2_control/base2AS2RWD.ros2_control.xacro" />
  <xacro:base_control mode="live" base_name="base" hardware_plugin="${live_hardware_plugin}" />

</robot>
