<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link" />
  <link name="left_sprocket_wheel_spinning_link" />
  <link name="right_sprocket_wheel_spinning_link" />
  <link name="front_left_idler_wheel_spinning_link" />
  <link name="front_right_idler_wheel_spinning_link" />
  <link name="rear_left_idler_wheel_spinning_link" />
  <link name="rear_right_idler_wheel_spinning_link" />

  <joint name="left_sprocket_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="left_sprocket_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>
  <joint name="right_sprocket_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="right_sprocket_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>
  <joint name="front_left_idler_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="front_left_idler_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>
  <joint name="front_right_idler_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="front_right_idler_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>
  <joint name="rear_left_idler_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="rear_left_idler_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>
  <joint name="rear_right_idler_wheel_spinning_joint" type="continuous"><parent link="base_link" /><child link="rear_right_idler_wheel_spinning_link" /><axis xyz="0 1 0" /></joint>

  <ros2_control name="robot" type="system">
    <hardware>
      <plugin>romea_mobile_base_simulation/GenericSimulationSystemInterface</plugin>
      <param name="simulation_interfaces">mobile_base</param>
      <param name="mobile_base.type">2THD</param>
      <param name="mobile_base.left_sprocket_wheel_spinning_joint_name">left_sprocket_wheel_spinning_joint</param>
      <param name="mobile_base.right_sprocket_wheel_spinning_joint_name">right_sprocket_wheel_spinning_joint</param>
      <param name="mobile_base.front_left_idler_wheel_spinning_joint_name">front_left_idler_wheel_spinning_joint</param>
      <param name="mobile_base.front_right_idler_wheel_spinning_joint_name">front_right_idler_wheel_spinning_joint</param>
      <param name="mobile_base.rear_left_idler_wheel_spinning_joint_name">rear_left_idler_wheel_spinning_joint</param>
      <param name="mobile_base.rear_right_idler_wheel_spinning_joint_name">rear_right_idler_wheel_spinning_joint</param>
      <param name="mobile_base.spinning_joint_command_interface_type">velocity</param>
      <param name="mobile_base.sprocket_wheel_radius">0.8</param>
      <param name="mobile_base.idler_wheel_radius">0.3</param>
      <param name="mobile_base.track_thickness">0.1</param>
    </hardware>
    <joint name="left_sprocket_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="right_sprocket_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="front_left_idler_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="front_right_idler_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_left_idler_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_right_idler_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>
</robot>
