<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link" />
  <link name="front_axle_steering_link" />
  <link name="front_left_wheel_spinning_link" />
  <link name="front_right_wheel_spinning_link" />
  <link name="front_left_wheel_steering_link" />
  <link name="front_right_wheel_steering_link" />
  <link name="rear_left_wheel_spinning_link" />
  <link name="rear_right_wheel_spinning_link" />

  <joint name="front_axle_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_axle_steering_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="1" effort="10" velocity="10" />
  </joint>

  <joint name="front_left_wheel_spinning_joint" type="continuous">
    <parent link="front_axle_steering_link" />
    <child link="front_left_wheel_spinning_link" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="front_right_wheel_spinning_joint" type="continuous">
    <parent link="front_axle_steering_link" />
    <child link="front_right_wheel_spinning_link" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="front_left_wheel_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_left_wheel_steering_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="1" effort="10" velocity="10" />
  </joint>

  <joint name="front_right_wheel_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_right_wheel_steering_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="1" effort="10" velocity="10" />
  </joint>

  <joint name="rear_left_wheel_spinning_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel_spinning_link" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="rear_right_wheel_spinning_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel_spinning_link" />
    <axis xyz="0 1 0" />
  </joint>

  <ros2_control name="robot" type="system">
    <hardware>
      <plugin>romea_mobile_base_simulation/GenericSimulationSystemInterface</plugin>

      <param name="simulation_interfaces">mobile_base</param>
      <param name="mobile_base.type">1FAS2RWD</param>

      <param name="mobile_base.front_axle_steering_joint_name">front_axle_steering_joint</param>
      <param name="mobile_base.front_left_wheel_spinning_joint_name">front_left_wheel_spinning_joint</param>
      <param name="mobile_base.front_right_wheel_spinning_joint_name">front_right_wheel_spinning_joint</param>
      <param name="mobile_base.front_left_wheel_steering_joint_name">front_left_wheel_steering_joint</param>
      <param name="mobile_base.front_right_wheel_steering_joint_name">front_right_wheel_steering_joint</param>
      <param name="mobile_base.rear_left_wheel_spinning_joint_name">rear_left_wheel_spinning_joint</param>
      <param name="mobile_base.rear_right_wheel_spinning_joint_name">rear_right_wheel_spinning_joint</param>

      <param name="mobile_base.spinning_joint_command_interface_type">velocity</param>
      <param name="mobile_base.wheelbase">1.3</param>
      <param name="mobile_base.front_track">0.8</param>
      <param name="mobile_base.front_wheel_radius">0.3</param>
      <param name="mobile_base.front_hub_carrier_offset">0.08</param>
      <param name="mobile_base.rear_track">1.4</param>
      <param name="mobile_base.rear_wheel_radius">0.7</param>
      <param name="mobile_base.rear_hub_carrier_offset">0.15</param>
    </hardware>

    <joint name="front_axle_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>

    <joint name="front_left_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="front_right_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="front_left_wheel_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>

    <joint name="front_right_wheel_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>

    <joint name="rear_left_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="rear_right_wheel_spinning_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

</robot>
