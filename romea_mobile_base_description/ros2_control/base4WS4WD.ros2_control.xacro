<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find romea_mobile_base_description)/ros2_control/base_control_joints.xacro" />

  <xacro:macro name="base_control_model">
    <link name="${prefix}${base_link}"/>

    <xacro:base_control_revolute_joint
      parent_link="${base_link}"
      child_link="${front_left_wheel_steering_link}"
      joint_name="${front_left_wheel_steering_joint}"
      velocity="${maximal_wheel_steering_angular_speed}"
      effort="${maximal_wheel_steering_torque}"
      lower="${-maximal_wheel_steering_angle}"
      upper="${maximal_wheel_steering_angle}"/>

    <xacro:base_control_revolute_joint
      parent_link="${base_link}"
      child_link="${front_right_wheel_steering_link}"
      joint_name="${front_right_wheel_steering_joint}"
      velocity="${maximal_wheel_steering_angular_speed}"
      effort="${maximal_wheel_steering_torque}"
      lower="${-maximal_wheel_steering_angle}"
      upper="${maximal_wheel_steering_angle}"/>

    <xacro:base_control_revolute_joint
      parent_link="${base_link}"
      child_link="${rear_left_wheel_steering_link}"
      joint_name="${rear_left_wheel_steering_joint}"
      velocity="${maximal_wheel_steering_angular_speed}"
      effort="${maximal_wheel_steering_torque}"
      lower="${-maximal_wheel_steering_angle}"
      upper="${maximal_wheel_steering_angle}"/>

    <xacro:base_control_revolute_joint
      parent_link="${base_link}"
      child_link="${rear_right_wheel_steering_link}"
      joint_name="${rear_right_wheel_steering_joint}"
      velocity="${maximal_wheel_steering_angular_speed}"
      effort="${maximal_wheel_steering_torque}"
      lower="${-maximal_wheel_steering_angle}"
      upper="${maximal_wheel_steering_angle}"/>

    <xacro:base_control_continuous_joint
      parent_link="${front_left_wheel_steering_link}"
      child_link="${front_left_wheel_spinning_link}"
      joint_name="${front_left_wheel_spinning_joint}"
      velocity="${maximal_wheel_speed/front_wheel_radius}"
      effort="${maximal_wheel_torque}"/>

    <xacro:base_control_continuous_joint
      parent_link="${front_right_wheel_steering_link}"
      child_link="${front_right_wheel_spinning_link}"
      joint_name="${front_right_wheel_spinning_joint}"
      velocity="${maximal_wheel_speed/front_wheel_radius}"
      effort="${maximal_wheel_torque}"/>

    <xacro:base_control_continuous_joint
      parent_link="${rear_left_wheel_steering_link}"
      child_link="${rear_left_wheel_spinning_link}"
      joint_name="${rear_left_wheel_spinning_joint}"
      velocity="${maximal_wheel_speed/rear_wheel_radius}"
      effort="${maximal_wheel_torque}"/>

    <xacro:base_control_continuous_joint
      parent_link="${rear_right_wheel_steering_link}"
      child_link="${rear_right_wheel_spinning_link}"
      joint_name="${rear_right_wheel_spinning_joint}"
      velocity="${maximal_wheel_speed/rear_wheel_radius}"
      effort="${maximal_wheel_torque}"/>
  </xacro:macro>

  <xacro:macro name="base_control_parameters" params="interface_name">
    <param name="wheelbase">${wheelbase}</param>
    <param name="front_track">${front_track}</param>
    <param name="rear_track">${rear_track}</param>
    <param name="front_wheel_radius">${front_wheel_radius}</param>
    <param name="rear_wheel_radius">${rear_wheel_radius}</param>
    <param name="${interface_name}.type">4WS4WD</param>
    <param name="${interface_name}.front_left_wheel_steering_joint_name">${prefix}${front_left_wheel_steering_joint}</param>
    <param name="${interface_name}.front_right_wheel_steering_joint_name">${prefix}${front_right_wheel_steering_joint}</param>
    <param name="${interface_name}.rear_left_wheel_steering_joint_name">${prefix}${rear_left_wheel_steering_joint}</param>
    <param name="${interface_name}.rear_right_wheel_steering_joint_name">${prefix}${rear_right_wheel_steering_joint}</param>
    <param name="${interface_name}.front_left_wheel_spinning_joint_name">${prefix}${front_left_wheel_spinning_joint}</param>
    <param name="${interface_name}.front_right_wheel_spinning_joint_name">${prefix}${front_right_wheel_spinning_joint}</param>
    <param name="${interface_name}.rear_left_wheel_spinning_joint_name">${prefix}${rear_left_wheel_spinning_joint}</param>
    <param name="${interface_name}.rear_right_wheel_spinning_joint_name">${prefix}${rear_right_wheel_spinning_joint}</param>
    <param name="${interface_name}.spinning_joint_command_interface_type">velocity</param>
    <param name="${interface_name}.wheelbase">${wheelbase}</param>
    <param name="${interface_name}.front_track">${front_track}</param>
    <param name="${interface_name}.rear_track">${rear_track}</param>
    <param name="${interface_name}.front_wheel_radius">${front_wheel_radius}</param>
    <param name="${interface_name}.rear_wheel_radius">${rear_wheel_radius}</param>
  </xacro:macro>

  <xacro:macro
    name="base_control_hardware"
    params="hardware_plugin interface_name has_hardware_options:=0">
    <hardware>
      <plugin>${hardware_plugin}</plugin>
      <param name="hardware_interfaces">${interface_name}</param>
      <xacro:base_control_parameters interface_name="${interface_name}" />

      <xacro:if value="${has_hardware_options}">
        <xacro:insert_block name="hardware_options"/>
      </xacro:if>
    </hardware>
  </xacro:macro>

  <xacro:macro name="base_control_joints" params="mode">
    <joint name="${prefix}${front_left_wheel_steering_joint}">
      <command_interface name="position">
        <param name="min">${-maximal_wheel_steering_angle}</param>
        <param name="max">${maximal_wheel_steering_angle}</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="${prefix}${front_right_wheel_steering_joint}">
      <command_interface name="position">
        <param name="min">${-maximal_wheel_steering_angle}</param>
        <param name="max">${maximal_wheel_steering_angle}</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="${prefix}${rear_left_wheel_steering_joint}">
      <command_interface name="position">
        <param name="min">${-maximal_wheel_steering_angle}</param>
        <param name="max">${maximal_wheel_steering_angle}</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="${prefix}${rear_right_wheel_steering_joint}">
      <command_interface name="position">
        <param name="min">${-maximal_wheel_steering_angle}</param>
        <param name="max">${maximal_wheel_steering_angle}</param>
      </command_interface>
      <state_interface name="position" />
    </joint>

    <joint name="${prefix}${front_left_wheel_spinning_joint}">
      <command_interface name="velocity">
        <param name="min">${-maximal_wheel_speed/front_wheel_radius}</param>
        <param name="max">${maximal_wheel_speed/front_wheel_radius}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${prefix}${front_right_wheel_spinning_joint}">
      <command_interface name="velocity">
        <param name="min">${-maximal_wheel_speed/front_wheel_radius}</param>
        <param name="max">${maximal_wheel_speed/front_wheel_radius}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${prefix}${rear_left_wheel_spinning_joint}">
      <command_interface name="velocity">
        <param name="min">${-maximal_wheel_speed/rear_wheel_radius}</param>
        <param name="max">${maximal_wheel_speed/rear_wheel_radius}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${prefix}${rear_right_wheel_spinning_joint}">
      <command_interface name="velocity">
        <param name="min">${-maximal_wheel_speed/rear_wheel_radius}</param>
        <param name="max">${maximal_wheel_speed/rear_wheel_radius}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <xacro:macro
    name="base_control"
    params="mode base_name hardware_plugin has_hardware_options:=0">

    <xacro:base_control_model/>

    <ros2_control name="${prefix}${base_name}" type="system">
      <xacro:base_control_hardware
        hardware_plugin="${hardware_plugin}"
        interface_name="${base_name}"
        has_hardware_options="${has_hardware_options}" />

      <xacro:base_control_joints mode="${mode}" />
    </ros2_control>

  </xacro:macro>

</robot>
