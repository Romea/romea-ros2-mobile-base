<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_caster">

  <xacro:property name="M_PI" value="3.14159" />

  <xacro:include filename="$(find romea_mobile_base_description)/urdf/wheel_free.xacro" />

  <xacro:macro name="wheel_caster"
    params="parent_link wheel_swiveling_link wheel_swiveling_joint swivel_link_mass swivel_link_xz swivel_link_y wheel_spinning_link wheel_spinning_joint wheel_origin_x wheel_origin_y wheel_mass wheel_width wheel_radius left_right swivel_damping:=0.1 swivel_friction:=0.01 *joint_origin *visual_swivel *visual_wheel">

    <link name="${prefix}${wheel_swiveling_link}">
      <xacro:insert_block name="visual_swivel" />
      <inertial>
        <mass value="${swivel_link_mass}" />
        <origin xyz="0 0 0" />
        <inertia
          ixx="${swivel_link_mass/12.0 * (swivel_link_y*swivel_link_y + swivel_link_xz*swivel_link_xz)}"
          ixy="0" ixz="0"
          iyy="${swivel_link_mass/12.0 * (swivel_link_xz*swivel_link_xz + swivel_link_xz*swivel_link_xz)}"
          iyz="0"
          izz="${swivel_link_mass/12.0 * (swivel_link_y*swivel_link_y + swivel_link_xz*swivel_link_xz)}" />
      </inertial>
    </link>

    <joint name="${prefix}${wheel_swiveling_joint}" type="continuous">
      <axis xyz="0 0 1" />
      <parent link="${prefix}${parent_link}" />
      <child link="${prefix}${wheel_swiveling_link}" />
      <xacro:insert_block name="joint_origin" />
      <dynamics damping="${swivel_damping}" friction="${swivel_friction}" />
    </joint>

    <xacro:wheel_free parent_link="${wheel_swiveling_link}"
      wheel_spinning_link="${wheel_spinning_link}"
      wheel_spinning_joint="${wheel_spinning_joint}"
      wheel_mass="${wheel_mass}"
      wheel_width="${wheel_width}"
      wheel_radius="${wheel_radius}"
      left_right="${left_right}">
      <origin xyz="${wheel_origin_x} ${wheel_origin_y} 0" rpy="${-M_PI/2} 0 0" />
      <xacro:insert_block name="visual_wheel" />
    </xacro:wheel_free>
  </xacro:macro>

</robot>
